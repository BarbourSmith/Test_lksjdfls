    {
      "atomType": "Molecule",
      "x": 0.4,
      "y": 0.5,
      "uniqueID": "id-6184",
      "name": "Guitar Body",
      "topLevel": false,
      "allAtoms": [
        {
          "atomType": "Output",
          "x": 1,
          "y": 0.5,
          "uniqueID": "id-6186",
          "ioValues": [
            {
              "name": "number or geometry",
              "ioValue": "__GEOMETRY_INPUT__"
            }
          ]
        },
        {
          "atomType": "Code",
          "x": 0.2,
          "y": 0.4,
          "uniqueID": "id-6188",
          "ioValues": [
            {
              "name": "bodyLength",
              "ioValue": 400
            },
            {
              "name": "bodyWidth",
              "ioValue": 325
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * Telecaster-style body outline (2D), front view, neck pointing +Y.\n * Butt end at y=0, neck end at y=bodyLength, centerline at x=0.\n * Bass side is -X, treble cutaway is +X (right-handed guitar).\n * bodyLength: mm, butt to neck end. bodyWidth: mm, across lower bout.\n * Curves meet with matching tangents so the edge flows without kinks.\n */\nfunction run(bodyLength: number = 400, bodyWidth: number = 325): Assembly {\n  const sx = bodyWidth / 325;\n  const sy = bodyLength / 400;\n  const p = (x: number, y: number): [number, number] => [x * sx, y * sy];\n\n  const outline = replicad\n    .draw(p(0, 0))\n    // broad, flat butt into the lower treble bout\n    .cubicBezierCurveTo(p(162.5, 125), p(128, 0), p(162.5, 45))\n    // gentle treble waist\n    .cubicBezierCurveTo(p(141, 245), p(162.5, 190), p(141, 210))\n    // upper treble bout rolling over into the cutaway\n    .cubicBezierCurveTo(p(88, 308), p(141, 285), p(122, 308))\n    // round cutaway scoop up to the horn tip\n    .cubicBezierCurveTo(p(42, 392), p(58, 308), p(42, 350))\n    // small round on the horn tip\n    .cubicBezierCurveTo(p(34, 400), p(42, 397), p(39, 400))\n    // flat neck end across the pocket to the bass shoulder\n    .lineTo(p(-85, 400))\n    // big rounded bass shoulder\n    .cubicBezierCurveTo(p(-146, 335), p(-125, 400), p(-146, 375))\n    // nearly straight upper bass side into a shallow waist\n    .cubicBezierCurveTo(p(-139, 245), p(-146, 300), p(-139, 275))\n    // lower bass bout\n    .cubicBezierCurveTo(p(-162.5, 125), p(-139, 210), p(-162.5, 190))\n    // back across the butt\n    .cubicBezierCurveTo(p(0, 0), p(-162.5, 45), p(-128, 0))\n    .close();\n\n  return new Assembly({ geometry: outline });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Telecaster-style body outline (2D), front view, neck pointing +Y.\n * Butt end at y=0, neck end at y=bodyLength, centerline at x=0.\n * Bass side is -X, treble cutaway is +X (right-handed guitar).\n * bodyLength: mm, butt to neck end. bodyWidth: mm, across lower bout.\n * Curves meet with matching tangents so the edge flows without kinks.\n */\nfunction run(bodyLength = 400, bodyWidth = 325) {\n    const sx = bodyWidth / 325;\n    const sy = bodyLength / 400;\n    const p = (x, y) => [x * sx, y * sy];\n    const outline = replicad\n        .draw(p(0, 0))\n        // broad, flat butt into the lower treble bout\n        .cubicBezierCurveTo(p(162.5, 125), p(128, 0), p(162.5, 45))\n        // gentle treble waist\n        .cubicBezierCurveTo(p(141, 245), p(162.5, 190), p(141, 210))\n        // upper treble bout rolling over into the cutaway\n        .cubicBezierCurveTo(p(88, 308), p(141, 285), p(122, 308))\n        // round cutaway scoop up to the horn tip\n        .cubicBezierCurveTo(p(42, 392), p(58, 308), p(42, 350))\n        // small round on the horn tip\n        .cubicBezierCurveTo(p(34, 400), p(42, 397), p(39, 400))\n        // flat neck end across the pocket to the bass shoulder\n        .lineTo(p(-85, 400))\n        // big rounded bass shoulder\n        .cubicBezierCurveTo(p(-146, 335), p(-125, 400), p(-146, 375))\n        // nearly straight upper bass side into a shallow waist\n        .cubicBezierCurveTo(p(-139, 245), p(-146, 300), p(-139, 275))\n        // lower bass bout\n        .cubicBezierCurveTo(p(-162.5, 125), p(-139, 210), p(-162.5, 190))\n        // back across the butt\n        .cubicBezierCurveTo(p(0, 0), p(-162.5, 45), p(-128, 0))\n        .close();\n    return new Assembly({ geometry: outline });\n}\n"
        },
