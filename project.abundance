            }
          ]
        },
        {
          "atomType": "Code",
          "x": 0.2,
          "y": 0.4,
          "uniqueID": "id-6188",
          "ioValues": [
            {
              "name": "bodyLength",
              "ioValue": 400
            },
            {
              "name": "bodyWidth",
              "ioValue": 325
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * Telecaster body outline (2D), traced from a straight-on photo of a\n * Fender Tele and scaled to a 400 mm body. Front view, neck pointing +Y.\n * Butt end at y=0, neck end near y=400, centerline at x=0.\n * Bass side is -X; treble side is +X, with the horn on the outer edge\n * and the cutaway scooped between the horn and the neck.\n * bodyLength: mm, butt to neck end. bodyWidth: mm, across lower bout.\n * The traced points are joined with a Catmull-Rom spline (as Beziers).\n */\nfunction run(bodyLength: number = 400, bodyWidth: number = 325): Assembly {\n  const sx = bodyWidth / 327;\n  const sy = bodyLength / 400;\n\n  // Traced edge, from the bass side of the neck, around the bass side,\n  // across the butt, up the treble side, over the horn, and down the\n  // cutaway, which flattens out as it reaches the neck pocket.\n  const traced: [number, number][] = [\n    [-30, 398], [-70, 399], [-105, 399], [-128, 394], [-140, 380],\n    [-144, 353], [-141, 315], [-135, 280], [-140, 245], [-152, 200],\n    [-162, 138], [-160, 85], [-140, 32], [-95, 4], [0, 0], [79, 3],\n    [128, 20], [154, 57], [165, 126], [158, 207], [140, 264],\n    [137, 309], [140, 357], [138, 384], [128, 401], [113, 403],\n    [101, 393], [91, 366], [76, 344], [56, 335], [38, 334],\n  ];\n  const pts = traced.map(([x, y]) => [x * sx, y * sy] as [number, number]);\n\n  // Open Catmull-Rom through the traced points (ends use their neighbor).\n  let pen = replicad.draw(pts[0]);\n  const n = pts.length;\n  for (let i = 0; i < n - 1; i++) {\n    const p0 = pts[Math.max(i - 1, 0)];\n    const p1 = pts[i];\n    const p2 = pts[i + 1];\n    const p3 = pts[Math.min(i + 2, n - 1)];\n    const c1: [number, number] = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];\n    const c2: [number, number] = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];\n    pen = pen.cubicBezierCurveTo(p2, c1, c2);\n  }\n\n  // Run the cutaway floor square into the neck pocket (no thin sliver),\n  // then close across the heel area; the neck pocket is cut from here.\n  const outline = pen\n    .lineTo([20 * sx, 334 * sy])\n    .lineTo([20 * sx, 398 * sy])\n    .close();\n\n  return new Assembly({ geometry: outline });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Telecaster body outline (2D), traced from a straight-on photo of a\n * Fender Tele and scaled to a 400 mm body. Front view, neck pointing +Y.\n * Butt end at y=0, neck end near y=400, centerline at x=0.\n * Bass side is -X; treble side is +X, with the horn on the outer edge\n * and the cutaway scooped between the horn and the neck.\n * bodyLength: mm, butt to neck end. bodyWidth: mm, across lower bout.\n * The traced points are joined with a Catmull-Rom spline (as Beziers).\n */\nfunction run(bodyLength = 400, bodyWidth = 325) {\n    const sx = bodyWidth / 327;\n    const sy = bodyLength / 400;\n    // Traced edge, from the bass side of the neck, around the bass side,\n    // across the butt, up the treble side, over the horn, and down the\n    // cutaway, which flattens out as it reaches the neck pocket.\n    const traced = [\n        [-30, 398], [-70, 399], [-105, 399], [-128, 394], [-140, 380],\n        [-144, 353], [-141, 315], [-135, 280], [-140, 245], [-152, 200],\n        [-162, 138], [-160, 85], [-140, 32], [-95, 4], [0, 0], [79, 3],\n        [128, 20], [154, 57], [165, 126], [158, 207], [140, 264],\n        [137, 309], [140, 357], [138, 384], [128, 401], [113, 403],\n        [101, 393], [91, 366], [76, 344], [56, 335], [38, 334],\n    ];\n    const pts = traced.map(([x, y]) => [x * sx, y * sy]);\n    // Open Catmull-Rom through the traced points (ends use their neighbor).\n    let pen = replicad.draw(pts[0]);\n    const n = pts.length;\n    for (let i = 0; i < n - 1; i++) {\n        const p0 = pts[Math.max(i - 1, 0)];\n        const p1 = pts[i];\n        const p2 = pts[i + 1];\n        const p3 = pts[Math.min(i + 2, n - 1)];\n        const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];\n        const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];\n        pen = pen.cubicBezierCurveTo(p2, c1, c2);\n    }\n    // Run the cutaway floor square into the neck pocket (no thin sliver),\n    // then close across the heel area; the neck pocket is cut from here.\n    const outline = pen\n        .lineTo([20 * sx, 334 * sy])\n        .lineTo([20 * sx, 398 * sy])\n        .close();\n    return new Assembly({ geometry: outline });\n}\n"
        },
