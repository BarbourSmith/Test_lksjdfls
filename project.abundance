    {
      "atomType": "Molecule",
      "x": 0.4,
      "y": 0.5,
      "uniqueID": "id-6184",
      "name": "Guitar Body",
      "topLevel": false,
      "allAtoms": [
        {
          "atomType": "Output",
          "x": 1,
          "y": 0.5,
          "uniqueID": "id-6186",
          "ioValues": [
            {
              "name": "number or geometry",
